; OMugen screenpack
;
; Built into OMugen.exe. Turn it on in Options > Video Settings >
; OMugen Screenpack; it also takes over by itself when a game's screenpack
; fails to load. The game's characters, stages (select.def), lifebars,
; menu sounds and music are used as they are.
;
; The select grid sizes itself to the roster: the biggest cells that show
; everyone at once, or a scrolling grid for big rosters (autolayout).
; All sprites are generated by tools/screenpackgen.

[Info]
name = OMugen
author = OMugen contributors
versiondate = 09,30,2026
mugenversion = 1.1
ikemenversion = 1.0
localcoord = 1920,1080

[Files]
spr = system.sff
snd = system.snd            ;replaced by the game's screenpack sounds
logo.storyboard =
intro.storyboard =
select = select.def         ;replaced by the game's select.def
fight = fight.def           ;replaced by the game's lifebars
font1 = fonts/xb.def        ;Open Sans ExtraBold
font2 = fonts/b.def         ;Open Sans Bold
font3 = fonts/sb.def        ;Open Sans SemiBold
font4 = fonts/r.def         ;Open Sans Regular

;-------------------------------------------------------------------
