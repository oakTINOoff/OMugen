; Proto Arena - the OMugen template stage
;
; A rooftop dojo at night in 1280x720, made of parallax layers: layers with a
; smaller delta scroll slower and look farther away. The sprites are in
; proto_arena.sff (generated by OMugen's tools/templategen).

[Info]
name = "Proto Arena"
displayname = "Proto Arena"
versiondate = 09,30,2026
mugenversion = 1.1
author = "OMugen"

[Camera]
