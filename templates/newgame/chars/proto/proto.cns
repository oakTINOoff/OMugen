; Proto - constants and states
;
; Units are pixels of the character's 1280x720 space (localcoord in
; proto.def); velocities are pixels per tick (60 ticks per second).
; Lines starting with ; are comments.

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 56
ground.front = 60
air.back = 48
air.front = 48
height = 250
attack.dist = 640
proj.attack.dist = 360
proj.doscale = 0
head.pos = -10, -320
mid.pos = -10, -230
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 9.6
walk.back = -8.8
run.fwd  = 18.4, 0
run.back = -18,-15.2
jump.neu = 0,-33.6
jump.back = -10.2,-33.6
jump.fwd = 10,-33.6
runjump.back = -10.2,-32.4
runjump.fwd = 16,-32.4
airjump.neu = 0,-32.4
airjump.back = -10.2
airjump.fwd = 10
air.gethit.groundrecover = -.6,-14
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-18
air.gethit.airrecover.back = -4
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -8
air.gethit.airrecover.down = 6

[Movement]
airjump.num = 1
airjump.height = 140
yaccel = 1.76
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = 8
crouch.friction.threshold = .2
air.gethit.groundlevel = 100
air.gethit.groundrecover.ground.threshold = -80
air.gethit.groundrecover.groundlevel = 40
air.gethit.airrecover.threshold = -4
air.gethit.airrecover.yaccel = 1.4
air.gethit.trip.groundlevel = 60
down.bounce.offset = 0, 80
down.bounce.yaccel = 1.6
down.bounce.groundlevel = 48
down.friction.threshold = .2

[Quotes]
victory1 = "Calibration complete."
victory2 = "Your inputs have been recorded. Mine were better."
victory3 = "Prototype, not beta."

;===========================================================================
; Intro and win pose
;===========================================================================
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, Done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

; The engine puts the round's winner in state 180: start the win pose.
[Statedef 180]
type = S

[State 180, Win pose]
type = ChangeState
trigger1 = Time = 0
value = 181

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, Finish the pose]
type = AssertSpecial
trigger1 = Time < 70        ;the round waits until the pose is done
flag = RoundNotOver

;===========================================================================
; Taunt (Start)
;===========================================================================
[Statedef 195]
type = S
movetype = I
physics = S
ctrl = 0
anim = 195
velset = 0,0
poweradd = 40

[State 195, Done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===========================================================================
; Standing attacks
;===========================================================================
; Light punch (x): a quick jab
[Statedef 200]
type = S
movetype = A
physics = S
juggle = 1
poweradd = 20
ctrl = 0
velset = 0,0
anim = 200
sprpriority = 2

[State 200, Hit]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA                ;standing, normal attack
damage = 26, 0              ;damage on hit, on guard
animtype = Light            ;how the opponent reacts
guardflag = MA              ;guardable standing or crouching
hitflag = MAF               ;hits standing, crouching and falling players
priority = 3, Hit
pausetime = 8, 8            ;hit pause for attacker, defender
sparkno = 0
sparkxy = -10, -250
hitsound = 5, 0             ;from the common sounds (fight.def)
guardsound = 6, 0
ground.type = High
ground.slidetime = 6
ground.hittime = 10
ground.velocity = -16
air.velocity = -10, -16

[State 200, Done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

