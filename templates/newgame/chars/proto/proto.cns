;===========================================================================
; Special move: Proto Blast (down, down-forward, forward + punch)
;===========================================================================
[Statedef 1000]
type = S
movetype = A
physics = S
juggle = 4
poweradd = 60
ctrl = 0
velset = 0,0
anim = 1000
sprpriority = 2

[State 1000, Shot]
type = Projectile
trigger1 = AnimElem = 3
projid = 1000
projanim = 1005             ;the orb (trans = add in proto.air)
projhitanim = 1006
projremanim = 1006
projcancelanim = 1006
offset = 175, -252          ;from the character's feet: at the hands
velocity = 24, 0
projpriority = 1
projsprpriority = 3
attr = S, SP                ;special projectile
damage = 80, 10
animtype = Medium
guardflag = MA
hitflag = MAF
pausetime = 0, 14
sparkno = -1                ;the orb draws its own impact
hitsound = 5, 2
guardsound = 6, 0
ground.type = High
ground.slidetime = 12
ground.hittime = 16
ground.velocity = -20
air.velocity = -14, -24
fall = 1

[State 1000, Done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

